{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vista_judge_packet_v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "image_name", "source_lang", "target_lang", "source_blocks", "candidate_blocks", "criteria", "tolerances"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "image_name": {"type": "string", "minLength": 1},
    "source_lang": {"type": "string", "minLength": 1},
    "target_lang": {"type": "string", "minLength": 2},
    "source_blocks": {"type": "array", "items": {"type": "object", "required": ["id", "text"]}},
    "candidate_blocks": {"type": "array", "items": {"type": "object", "required": ["id", "text"]}},
    "criteria": {"type": "array", "items": {"type": "object"}},
    "tolerances": {"type": "array", "items": {"type": "object"}}
  }
}
